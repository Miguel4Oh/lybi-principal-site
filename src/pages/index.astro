---
import "../styles/global.css";
import { Font } from "astro:assets";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Lybi</title>
        <Font cssVariable="--font-nico" preload/>
        <Font cssVariable="--font-nunito" preload/>
    </head>
    <body class="bg-primary">
        <nav>
            <div>
                <a href="/" class="font-nico text-white text-4xl">LYBI</a>
            </div>
            <div>
                <ul>
                    <li><a href="/quienes-somos" class="font-nunito text-white text-1xl">QUIENES SOMOS</a></li>
                    <li><a href="/proyectos" class="font-nunito text-white text-1xl">PROYECTOS</a></li>
                </ul>
            </div>
        </nav>
    </body>
</html>
