                                <div class="flex flex-col gap-2">
                                    <label
                                        class="font-label-sm text-label-sm uppercase text-primary/60"
                                        >Correo Corporativo</label
                                    >
                                    <input
                                        class="bg-surface p-4 border border-primary/20 focus:border-primary focus:ring-0 outline-none transition-all"
                                        placeholder="juan@empresa.com"
                                        type="email"
                                    />
