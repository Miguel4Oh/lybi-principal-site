---
import "../styles/global.css";
import { Font } from "astro:assets";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Lybi</title>
        <Font cssVariable="--font-nico" preload />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="font-body-md text-on-background selection:bg-primary-container selection:text-on-primary-container"
    >
        <div id="top"></div>
        <!-- Header / TopNavBar - Updated to be smaller, pill-shaped, and less wide -->
        <header
            class="fixed top-6 left-1/2 -translate-x-1/2 rounded-full w-[90%] max-w-[1200px] z-50 bg-primary dark:bg-primary-container border border-outline/20 shadow-lg flex justify-between items-center px-8 py-2.5 origin-top transform-gpu transition-all duration-300 ease-in-out"
        >
            <a
                class="font-nico text-xl text-on-primary tracking-tighter"
                href="#top"
            >
                LYBI
            </a>
            <nav class="hidden md:flex gap-12 items-center">
                <a
                    class="font-label-sm text-[14px] text-on-primary border-b border-on-primary pb-0.5 transition-all hover:opacity-90"
                    href="#soluciones">Soluciones</a
                >
                <a
                    class="font-label-sm text-[14px] text-on-primary/60 font-medium transition-all hover:text-on-primary"
                    href="#casos">Proyectos</a
                >
                <a
                    class="font-label-sm text-[14px] text-on-primary/60 font-medium transition-all hover:text-on-primary"
                    href="#proceso">Método</a
                >
                <a
                    class="font-label-sm text-[14px] text-on-primary/60 font-medium transition-all hover:text-on-primary"
                    href="#contacto">Contacto</a
                >
            </nav>
            <button
                class="bg-surface-container-lowest text-primary px-5 py-1.5 rounded-full font-button text-[13px] hover:opacity-90 transition-all uppercase tracking-wider"
            >
                Consulta
            </button>
        </header>
        <main>
            <!-- Hero Section - Rewritten for Business Focus -->
            <section
                class="min-h-screen flex flex-col justify-center items-center px-margin-mobile md:px-margin-desktop pt-40 pb-section-gap text-center max-w-container-max mx-auto"
            >
                <div
                    class="inline-block py-1 px-3 border border-primary/20 rounded-full mb-base font-label-sm text-label-sm text-primary/60 uppercase"
                >
                    Consultoría de Transformación Digital
                </div>
                <h1
                    class="font-display-lg text-[40px] leading-tight md:text-display-lg mb-8 max-w-5xl"
                >
                    Transformamos sus retos de negocio en <span
                        class="text-primary italic"
                        >soluciones digitales eficientes</span
                    >.
                </h1>
                <p
                    class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-12"
                >
                    Ayudamos a empresas a escalar operaciones y optimizar
                    procesos mediante software diseñado para el crecimiento.
                    Resultados tangibles, sin complicaciones técnicas.
                </p>
                <div class="flex flex-col md:flex-row gap-4">
                    <a
                        class="bg-primary-container text-on-primary px-10 py-4 font-button text-button uppercase block-shadow hover:translate-y-[-2px] transition-transform"
                        href="#contacto"
                    >
                        Iniciar Consultoría
                    </a>
                    <a
                        class="border border-primary-container text-primary-container px-10 py-4 font-button text-button uppercase hover:bg-primary-container hover:text-on-primary transition-all"
                        href="#casos"
                    >
                        Nuestros Casos de Éxito
                    </a>
                </div>
            </section>
            <!-- Tech Tray - More subtle and integrated -->
            <div
                class="py-8 border-y border-outline/5 overflow-hidden"
                style="background-color: #1b1c1f;"
            >
                <div class="animate-marquee whitespace-nowrap">
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Escalabilidad Garantizada</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Seguridad de Datos</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Optimización de Procesos</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Infraestructura Robusta</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Continuidad de Negocio</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Transformación Digital</span
                    >
                    <!-- Marquee duplicate -->
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Escalabilidad Garantizada</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Seguridad de Datos</span
                    >
                    <span
                        class="font-label-sm text-[12px] uppercase px-12"
                        style="color: #f5f5f5;">Optimización de Procesos</span
                    >
                </div>
            </div>
            <!-- Soluciones Section (Bento Grid) - Updated for Business focus -->
            <section
                class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto"
                id="soluciones"
            >
                <div class="mb-20">
                    <h2
                        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-4"
                    >
                        Nuestras Soluciones
                    </h2>
                    <div class="h-1 w-20 bg-primary"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
                    <!-- Solución 1 -->
                    <div
                        class="md:col-span-8 bg-white p-12 border border-outline/10 block-shadow relative overflow-hidden group"
                    >
                        <div class="relative z-10">
                            <span
                                class="material-symbols-outlined text-4xl mb-6 text-primary"
                                >analytics</span
                            >
                            <h3 class="font-headline-md text-headline-md mb-4">
                                Optimización de Procesos Internos
                            </h3>
                            <p
                                class="font-body-md text-body-md text-on-surface-variant max-w-md"
                            >
                                Digitalizamos las tareas manuales de su empresa
                                para reducir errores operativos y aumentar la
                                productividad de su equipo.
                            </p>
                            <ul
                                class="mt-8 space-y-2 font-label-sm text-label-sm text-primary/70 uppercase"
                            >
                                <li class="">_ Automatización de flujos</li>
                                <li class="">
                                    _ Reducción de costos operativos
                                </li>
                                <li class="">_ Dashboards de gestión</li>
                            </ul>
                        </div>
                    </div>
                    <!-- Solución 2 -->
                    <div
                        class="md:col-span-4 bg-primary-container text-on-primary p-12 flex flex-col justify-between"
                    >
                        <div>
                            <span
                                class="material-symbols-outlined text-4xl mb-6 text-on-primary"
                                >trending_up</span
                            >
                            <h3 class="font-headline-md text-headline-md mb-4">
                                Escalabilidad
                            </h3>
                            <p class="font-body-md text-body-md opacity-70">
                                Preparamos su plataforma tecnológica para
                                soportar el crecimiento de usuarios sin
                                interrupciones.
                            </p>
                        </div>
                        <a
                            class="mt-12 inline-flex items-center gap-2 font-label-sm text-label-sm uppercase hover:gap-4 transition-all"
                            href="#"
                        >
                            Ver más <span class="material-symbols-outlined"
                                >arrow_forward</span
                            >
                        </a>
                    </div>
                    <!-- Solución 3 -->
                    <div
                        class="md:col-span-4 bg-surface-container-high p-12 border border-outline/10"
                    >
                        <span
                            class="material-symbols-outlined text-4xl mb-6 text-primary"
                            >cloud_sync</span
                        >
                        <h3 class="font-headline-md text-headline-md mb-4">
                            Modernización
                        </h3>
                        <p
                            class="font-body-md text-body-md text-on-surface-variant"
                        >
                            Actualizamos sus sistemas antiguos a tecnologías
                            modernas para garantizar la continuidad de su
                            negocio.
                        </p>
                    </div>
                    <!-- Solución 4 -->
                    <div
                        class="md:col-span-8 bg-white p-12 border border-outline/10 block-shadow"
                    >
                        <div class="grid md:grid-cols-2 gap-8 items-center">
                            <div>
                                <span
                                    class="material-symbols-outlined text-4xl mb-6 text-primary"
                                    >verified_user</span
                                >
                                <h3
                                    class="font-headline-md text-headline-md mb-4"
                                >
                                    Estrategia de Datos
                                </h3>
                                <p
                                    class="font-body-md text-body-md text-on-surface-variant"
                                >
                                    Organizamos su información de negocio para
                                    que sea segura, accesible y útil para la
                                    toma de decisiones estratégicas.
                                </p>
                            </div>
                            <div
                                class="bg-primary-container p-8 rounded-lg flex items-center justify-center"
                            >
                                <div class="text-center">
                                    <p
                                        class="text-on-primary font-headline-md text-4xl"
                                    >
                                        100%
                                    </p>
                                    <p
                                        class="text-on-primary/60 font-label-sm uppercase mt-2"
                                    >
                                        Disponibilidad
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Case Studies Section -->
            <section
                class="py-section-gap bg-primary-container text-on-primary"
                id="casos"
            >
                <div
                    class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto"
                >
                    <div
                        class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8"
                    >
                        <div>
                            <h2
                                class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-4"
                            >
                                Historias de Éxito
                            </h2>
                            <p
                                class="font-body-lg text-body-lg opacity-60 max-w-xl"
                            >
                                Impacto real en sectores financieros, salud y
                                comercio a gran escala.
                            </p>
                        </div>
                        <div class="hidden md:block">
                            <div class="flex gap-4">
                                <button
                                    class="p-4 border border-on-primary/20 hover:bg-on-primary hover:text-primary transition-all"
                                >
                                    <span class="material-symbols-outlined"
                                        >west</span
                                    >
                                </button>
                                <button
                                    class="p-4 border border-on-primary/20 hover:bg-on-primary hover:text-primary transition-all"
                                >
                                    <span class="material-symbols-outlined"
                                        >east</span
                                    >
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
