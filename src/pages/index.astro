        <!-- Footer -->
        <footer
            class="bg-primary dark:bg-primary-container w-full py-section-gap px-margin-desktop flex flex-col md:flex-row justify-between items-center gap-base border-t border-outline/10"
        >
            <div class="flex flex-col gap-4">
                <div
                    class="font-headline-md text-headline-md font-bold text-on-primary"
                >
                    MONOLITH_DEV
                </div>
                <p
                    class="font-body-md text-body-md text-on-primary/50 max-w-xs text-center md:text-left"
                >
                    Integridad estratégica para la era digital. Soluciones
                    diseñadas para perdurar.
                </p>
            </div>
            <div class="flex flex-col items-center md:items-end gap-6">
                <nav class="flex flex-wrap justify-center gap-8">
