                                </div>
                                <span
                                    class="material-symbols-outlined text-4xl transform -rotate-45 group-hover:rotate-0 transition-transform"
                                    >north_east</span
                                >
                            </div>
                        </div>
                        <!-- Project 2 -->
                        <div class="group cursor-pointer">
                            <div
                                class="aspect-square overflow-hidden bg-surface mb-8"
                            >
                                <img
                                    alt="Infraestructura escalable"
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale hover:grayscale-0"
                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuB1-RHnbgMWHnhlagwLo9fuCTi5zMX10fDqh_7cLNIpe0-cj8ZZmvX8s-znXfjvd1bwadAaPrlxd8Ph1WiGdS6nYQkki8CeY8zJP4fqVNC9zkr39IfZ75hjx3FC0WkDjDKYqnaj5TMlV7X5ITxolWp_uI0_Pr8HkvBvrR7A8KoAN43iUnVbIK2NYIkqJlnopemMq3elNc4A14MA2Ie51Ghv0-ax1xtOobd7Fa6muZSqr1vhJNrRy5ZzgF6VJ5hHbWAHBBkTI0taowk"
                                />
                            </div>
                            <div class="flex justify-between items-start">
                                <div>
                                    <p
                                        class="font-label-sm text-label-sm text-on-primary-container mb-2 uppercase"
                                    >
                                        Logística Inteligente
                                    </p>
                                    <h4
                                        class="font-headline-md text-headline-md group-hover:underline underline-offset-4"
                                    >
                                        Red NEURALIS
                                    </h4>
                                </div>
                                <span
                                    class="material-symbols-outlined text-4xl transform -rotate-45 group-hover:rotate-0 transition-transform"
                                    >north_east</span
                                >
                            </div>
                        </div>
                        <!-- Project 3 -->
                        <div class="group cursor-pointer">
                            <div
                                class="aspect-square overflow-hidden bg-surface mb-8"
                            >
                                <img
                                    alt="Oficina de gestión digital"
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale hover:grayscale-0"
                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBOMwSCApa18v2xQVv84-PCLwSIDvnPT_SeHv44pl7_f5iS4Wjnkxhuj5u_G-Pv8-6DgBTd7yfvvobU6bCHyLejKSIVdGwYXcNEBx_sNWcxHktXNYFrSo6Gr8sSFOmQvO_3VNfQOtZuU6J3tPGIKPLwf_-JSkgZBlcyG9DAR8cUuj7nTIGBHld1mkOO36SSyzklhyz5XfZ6gym_sX1D9ygyT_S_lxhEDXK7YjVLGIrge0Kb926A7yf_4HwlvURcx2cSEJ9ZWcDAI1E"
                                />
                            </div>
                            <div class="flex justify-between items-start">
                                <div>
                                    <p
                                        class="font-label-sm text-label-sm text-on-primary-container mb-2 uppercase"
                                    >
                                        E-Commerce
                                    </p>
                                    <h4
                                        class="font-headline-md text-headline-md group-hover:underline underline-offset-4"
                                    >
                                        Núcleo AXIS
                                    </h4>
                                </div>
                                <span
                                    class="material-symbols-outlined text-4xl transform -rotate-45 group-hover:rotate-0 transition-transform"
                                    >north_east</span
                                >
                            </div>
