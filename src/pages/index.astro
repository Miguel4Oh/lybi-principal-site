                    </div>
                </div>
            </section>
            <!-- Contact Section -->
            <section
                class="py-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto"
                id="contacto"
            >
                <div class="grid md:grid-cols-2 gap-20">
                    <div>
                        <h2
                            class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-8"
                        >
                            Comencemos la <br />Conversación
                        </h2>
                        <p
                            class="font-body-lg text-body-lg text-on-surface-variant mb-12"
                        >
                            ¿Tiene un reto de negocio que requiere una solución
                            digital sólida? Nuestro equipo de consultores está
                            listo para analizar su caso.
                        </p>
                        <div class="space-y-8">
                            <div>
                                <p
                                    class="font-label-sm text-label-sm uppercase text-primary/40 mb-2"
                                >
                                    Ubicación
                                </p>
                                <p class="font-body-lg text-body-lg">
                                    64 Precision Ave, Distrito Tecnológico<br
                                    />SF, California 94103
                                </p>
                            </div>
                            <div>
                                <p
                                    class="font-label-sm text-label-sm uppercase text-primary/40 mb-2"
                                >
