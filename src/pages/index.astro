                            </div>
                            <div class="flex flex-col gap-2">
                                <label
                                    class="font-label-sm text-label-sm uppercase text-primary/60"
                                    >Tipo de Solución</label
                                >
                                <select
                                    class="bg-surface p-4 border border-primary/20 focus:border-primary focus:ring-0 outline-none transition-all"
                                >
                                    <option>Optimización de Procesos</option>
                                    <option>Escalabilidad de Plataformas</option
                                    >
                                    <option>Modernización Digital</option>
                                    <option>Otro Reto de Negocio</option>
                                </select>
                            </div>
                            <div class="flex flex-col gap-2">
                                <label
                                    class="font-label-sm text-label-sm uppercase text-primary/60"
                                    >Resumen del Reto</label
