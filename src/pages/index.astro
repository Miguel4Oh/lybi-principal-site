                        class="font-label-sm text-label-sm text-on-primary/50 hover:text-on-primary underline transition-colors"
                        href="#">Política de Privacidad</a
                    >
                    <a
                        class="font-label-sm text-label-sm text-on-primary/50 hover:text-on-primary underline transition-colors"
                        href="#">Términos de Servicio</a
                    >
                    <a
                        class="font-label-sm text-label-sm text-on-primary/50 hover:text-on-primary underline transition-colors"
                        href="#">LinkedIn</a
                    >
                </nav>
                <div
                    class="font-label-sm text-label-sm text-on-primary/50 uppercase tracking-widest"
                >
                    © 2024 MONOLITH SOFTWARE AG. DISEÑO ESTRATÉGICO PARA
                    EMPRESAS.
                </div>
            </div>
        </footer>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const header = document.querySelector("header");

                if (!header) {
                    return;
                }

                let compactTimer:
                    | ReturnType<typeof window.setTimeout>
                    | undefined;

                const compactClasses = [
                    "top-6",
                    "rounded-full",
                    "w-[90%]",
                    "max-w-[1200px]",
                    "px-8",
                    "py-2.5",
                ];
                const expandedClasses = [
                    "top-0",
                    "rounded-none",
                    "w-[100%]",
                    "max-w-none",
                    "px-margin-mobile",
                    "md:px-margin-desktop",
                    "py-4",
                ];

                const setCompactHeader = () => {
                    header.classList.remove(...expandedClasses);
                    header.classList.add(...compactClasses);
                };

                const setExpandedHeader = () => {
                    header.classList.remove(...compactClasses);
                    header.classList.add(...expandedClasses);
                };

                const syncHeaderSpacing = () => {
                    if (compactTimer !== undefined) {
                        window.clearTimeout(compactTimer);
                        compactTimer = undefined;
                    }

                    if (window.scrollY === 0) {
                        compactTimer = window.setTimeout(() => {
                            if (window.scrollY === 0) {
                                setCompactHeader();
                            }

                            compactTimer = undefined;
                        }, 160);
                    } else {
                        setExpandedHeader();
                    }
                };

                syncHeaderSpacing();

                window.addEventListener("scroll", syncHeaderSpacing, {
                    passive: true,
                });
            });
        </script>
    </body>
</html>
