---
import "../styles/global.css";
import { Font } from "astro:assets";
import mainPhoto from "@images/main-photo.png";
import { Image } from "astro:assets";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Lybi</title>
        <Font cssVariable="--font-nico" preload />
        <Font cssVariable="--font-nunito" preload />
    </head>
    <body class="bg-primary">
        <div
            class="absolute
                top-[-50px]
                sm:top-[-100px]
                md:top-[-200px]
                lg:top-[-450px]
                left-[100px]
                w-[50vw]
                h-[50vw]
                bg-white
                rounded-full
                blur-[200px]
                opacity-25
                lg:opacity-20
                -z-10"
        >
        </div>
        <header class="relative h-screen">
            <div
                class="absolute inset-0 -z-10
                [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]
                [-webkit-mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
            >
                <Image
                    src={mainPhoto}
                    alt="Main Photo"
                    class="w-full h-full object-cover
                        brightness-15
                        grayscale-70
                        saturate-20
                        opacity-70"
                />
            </div>

            <div class="absolute inset-0 flex items-center justify-center z-10">
                <div class="text-white">
                    <h1
                        class="font-nico text-8xl md:text-[170px] text-center [text-shadow:10px_10px_20px_rgba(0,0,0,0.5)]"
                    >
                        LYBI
                    </h1>

                    <p
                        class="font-nunito text-base md:text-xl text-right mt-2 translate-x-15 text-[#A2A2A2] [text-shadow:10px_10px_20px_rgba(0,0,0,0.5)]"
                    >
                        Desarrollo de software
                    </p>
                </div>
            </div>

            <nav class="px-15 py-3 flex justify-between items-center">
                <div>
                    <a href="/" class="font-nico text-white text-3xl">LYBI</a>
                </div>
                <div>
                    <ul class="flex gap-6">
                        <li>
                            <a
                                href="/quienes-somos"
                                class="font-nunito text-white text-sm"
                                >QUIENES SOMOS</a
                            >
                        </li>
                        <li>
                            <a
                                href="/proyectos"
                                class="font-nunito text-white text-sm"
                                >PROYECTOS</a
                            >
                        </li>
                        <li>
                            <a
                                href="/contacto"
                                class="font-nunito text-white text-sm"
                                >CONTACTO</a
                            >
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <hr
            class="w-200 mx-auto h-[2px] border-0 bg-gradient-to-r from-transparent via-[#a2a2a2] to-transparent opacity-25"
        />
        <main class="px-40">
            <section class="text-center my-20">
                <h1 class="font-nico text-white text-3xl">¿Quienes somos?</h1>
                <div
                    class="max-w-6xl mx-auto
        grid md:grid-cols-2 gap-10 items-center"
                >
                    <!-- 📝 TEXTO -->
                    <div
                        class="rounded-xl p-8 md:p-10
            shadow-[0_15px_50px_rgba(0,0,0,0.5)]"
                    >
                        <p
                            class="font-nunito text-white text-sm md:text-lg leading-relaxed"
                        >
                            En Lybi desarrollamos soluciones de software
                            diseñadas para resolver necesidades reales de
                            personas y empresas. Nuestro enfoque se basa en
                            comprender cada proyecto, analizar sus
                            requerimientos y crear sistemas funcionales que
                            ayuden a optimizar procesos, mejorar la gestión de
                            la información y facilitar el crecimiento de los
                            negocios.
                            <br /><br />
                            Cada solución se construye utilizando tecnologías modernas
                            y buenas prácticas de desarrollo, garantizando sistemas
                            eficientes, escalables y fáciles de usar. Desde aplicaciones
                            web y plataformas digitales hasta herramientas especializadas
                            para la automatización de procesos, en Lybi trabajamos
                            para transformar ideas en soluciones tecnológicas que
                            generen valor.
                        </p>
                    </div>

                    <!-- 🎨 CONTENIDO DERECHO -->
                    <div
                        class="relative rounded-xl overflow-hidden
                            shadow-[0_15px_50px_rgba(0,0,0,0.5)]"
                    >
                        <img
                            src="/images/software-dev.jpg"
                            alt="Desarrollo de software"
                            class="w-full h-full object-cover opacity-70"
                        />

                        <!-- Overlay sutil -->
                        <div
                            class="absolute inset-0
                             bg-black/40 backdrop-blur-[2px]"
                        >
                        </div>

                        <!-- Texto encima -->
                        <div class="absolute bottom-6 left-6 right-6">
                            <p
                                class="font-nunito text-white text-sm md:text-base"
                            >
                                Creamos soluciones digitales que impulsan el
                                crecimiento de tu negocio.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </body>
</html>
